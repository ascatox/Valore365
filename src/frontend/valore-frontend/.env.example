# Backend API base URL (leave empty for local dev with proxy)
VITE_API_BASE_URL=

# Clerk publishable key (leave empty to disable auth)
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: public URL of the backend MCP endpoint shown in Settings
# (default: origin of VITE_API_BASE_URL + /mcp; see docs/mcp.md).
# Production value below; for local dev use http://localhost:8000/mcp or leave empty.
VITE_MCP_SERVER_URL=https://valore365.onrender.com/mcp
