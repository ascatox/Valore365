APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/valore365

FINANCE_PROVIDER=yfinance
FINANCE_API_BASE_URL=
FINANCE_API_KEY=
FINANCE_REQUEST_TIMEOUT_SECONDS=10
FINANCE_MAX_RETRIES=3
FINANCE_RETRY_BACKOFF_SECONDS=0.5
FINANCE_SYMBOL_REQUEST_DELAY_SECONDS=0
# Parallel quote requests per price refresh (sequential when the delay above is > 0)
FINANCE_QUOTE_CONCURRENCY=4

PRICE_SCHEDULER_ENABLED=false
PRICE_SCHEDULER_INTERVAL_SECONDS=60
PRICE_SCHEDULER_PORTFOLIO_ID=
# Scheduler only: skip assets whose exchange is closed (manual refreshes are not filtered)
PRICE_SCHEDULER_MARKET_HOURS_ONLY=true
# Keep refreshing this many minutes after the close, to catch the closing auction price
PRICE_SCHEDULER_AFTER_CLOSE_GRACE_MINUTES=30
# TASK-54: sincronizzazione dei dati di mercato (docs/market-data-sync.md).
# Token Bearer di /api/internal/market-data/sync (vuoto = endpoint disattivati).
MARKET_DATA_SYNC_TOKEN=
MARKET_DATA_SYNC_ON_STARTUP=true
MARKET_DATA_SYNC_MAX_LOOKBACK_DAYS=30
MARKET_DATA_SYNC_GRACE_MINUTES=60
# TASK-80: corsa notturna dell'Auditor (vuoto = endpoint interni disattivati)
AUDITOR_RUN_TOKEN=
AUDITOR_MAX_CONCURRENCY=2
AUDITOR_MAX_DURATION_S=1800
AUDITOR_USER_MAX_DURATION_S=300
AUDITOR_RULE_TIMEOUT_S=30

PAC_SCHEDULER_ENABLED=false
PAC_EXECUTION_HOUR=8

CLERK_AUTH_ENABLED=false
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=

# Admin access: prefer user ids, email allowlist can be used as a pragmatic fallback.
ADMIN_USER_IDS=
# Your clerk account
ADMIN_EMAILS=

# Reverse proxy / frontend origins
# Comma-separated explicit origins, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://valore365.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional regex for preview deploys, e.g.:
# CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ALLOWED_ORIGIN_REGEX=
TRUSTED_PROXY_IPS=

# Per-user rate limiting (authenticated endpoints)
AUTHENTICATED_RATE_LIMIT_REQUESTS=120
AUTHENTICATED_RATE_LIMIT_WINDOW_SECONDS=60

# Public instant analyzer hardening
PUBLIC_INSTANT_ANALYZER_RATE_LIMIT_REQUESTS=10
PUBLIC_INSTANT_ANALYZER_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_INSTANT_ANALYZER_MAX_POSITIONS=50
PUBLIC_INSTANT_ANALYZER_MAX_RAW_TEXT_CHARS=5000
PUBLIC_INSTANT_ANALYZER_MAX_LINE_LENGTH=128

# CSV import hardening
CSV_IMPORT_MAX_UPLOAD_BYTES=5242880

# Portfolio Doctor - Tribunale del portafoglio (docs/tribunale/api-contracts.md)
# false = /api/doctor/tribunal/* answer 404 feature_disabled.
DOCTOR_TRIBUNAL_ENABLED=true
# New sessions per user per day (Europe/Rome) paid with the server Copilot key; 0 = only with the user's own key.
DOCTOR_TRIBUNAL_DAILY_LIMIT=3

# Copilot
COPILOT_PROVIDER=
COPILOT_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COPILOT_LOCAL_URL=http://localhost:11434/v1
COPILOT_LOCAL_API_KEY=not-needed
# Required to save user Copilot API keys from /api/settings/user.
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COPILOT_ENCRYPTION_KEY=

# TASK-57: field-level encryption of personal data (docs/field-encryption.md).
# Required when APP_ENV=prod; empty in dev = personal fields stored in plaintext.
# Keyring "kid:base64key[,kid:base64key]" of 32-byte keys, the first one is active:
# python3 -c "import base64, os; print('k1:' + base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEYS=
# HMAC key of the blind indexes (base64, 32 bytes): never change it once set.
# python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
DATA_BLIND_INDEX_KEY=
# Background backfill at startup (encrypts legacy plaintext, fills the blind indexes;
# one instance at a time via advisory lock). false = run scripts/encrypt_existing_data.py by hand.
DATA_BACKFILL_ON_STARTUP=true
DATA_BACKFILL_BATCH_SIZE=500
DATA_BACKFILL_BATCH_PAUSE_SECONDS=0.2

# Price validation thresholds
PRICE_VALIDATION_MIN_PRICE=0.0001
PRICE_VALIDATION_MAX_DAILY_CHANGE_PCT=50
PRICE_VALIDATION_MAX_OHLC_SPREAD_PCT=100
PRICE_VALIDATION_STALE_DAYS=5
PRICE_VALIDATION_FX_MIN_RATE=0.0001
PRICE_VALIDATION_FX_MAX_RATE=10000

# FMT API KEY Financial Modeling Prep  https://intelligence.financialmodelingprep.com/
# Used for the earnings calendar of the Markets tab (Yahoo when empty) and as
# a fallback for ETF data.
FMT_API_KEY=

# Remote MCP server, read-only (see docs/mcp.md). Served at /mcp only when
# MCP_ENABLED=true AND CLERK_AUTH_ENABLED=true AND the URLs below are set.
MCP_ENABLED=false
# Public URL of the /mcp endpoint (OAuth resource / audience).
# Production: https://valore365.onrender.com/mcp ; local: http://localhost:8000/mcp
MCP_RESOURCE_URL=
# Identity advertised in the MCP initialize serverInfo (https only, otherwise omitted).
# MCP_ICON_BASE_URL empty -> icons from MCP_WEBSITE_URL (/icons/icon-192x192.png, /icons/icon-512x512.png)
MCP_WEBSITE_URL=https://valore365.vercel.app
MCP_ICON_BASE_URL=
# Clerk Frontend API URL (authorization server, JWT issuer), e.g. https://clerk.example.com
CLERK_ISSUER=
# Only needed for opaque OAuth access tokens (oat_...); not needed for JWT access tokens
CLERK_SECRET_KEY=
CLERK_API_URL=https://api.clerk.com/v1
# Optional hardening
MCP_ALLOWED_CLIENT_IDS=
MCP_SCOPES_SUPPORTED=profile email
MCP_REQUIRED_SCOPES=
MCP_REQUIRE_AUDIENCE=false
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_REQUESTS=60
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_TOKEN_CACHE_SECONDS=60
# Hardening (docs/mcp.md, "Hardening"). Limits are in-memory, per process.
# Failed authentications per client IP before 429 (0 = off). Behind a proxy
# set TRUSTED_PROXY_IPS, otherwise every client shares the proxy's IP.
MCP_AUTH_FAILURE_LIMIT=20
MCP_AUTH_FAILURE_WINDOW_SECONDS=300
MCP_NEGATIVE_TOKEN_CACHE_SECONDS=60
# Max JWT lifetime (exp - iat) in seconds, 0 = no check
MCP_MAX_TOKEN_LIFETIME_SECONDS=86400
MCP_TOOL_TIMEOUT_SECONDS=20
MCP_MAX_CONCURRENT_CALLS_PER_USER=4
MCP_HEAVY_TOOL_RATE_LIMIT_REQUESTS=10
MCP_HEAVY_TOOL_RATE_LIMIT_WINDOW_SECONDS=60
# Gradual rollout / kill switch: Clerk user ids (user_...), comma separated.
# Allowed empty = every user; blocked users always get 403.
MCP_ALLOWED_USER_IDS=
MCP_BLOCKED_USER_IDS=
